Testing/
.cache/

# ---------------------------------------------------------------------------
# terco
# ---------------------------------------------------------------------------

# Python bytecode from the generators and the porting tools.
__pycache__/
*.py[cod]

# Test OUTPUTS.
#
# The checks write their results beside the oracles they read, so inputs and
# outputs share `test/` and only the inputs belong in git:
#
#   keep    reference*.dat   recorded libfint integrals, the oracles
#           *.xyz            geometries
#   ignore  *.bin            multipole dumps, rewritten on every run
#           *.efp            the fragment potential demo_makefp writes
#
test/*.bin
test/*.efp

# fpm's build tree, if it is not called `build/`.
build*/
.fpm/

# Editor and OS droppings.
*.orig
*.rej
.vscode/
.idea/
.DS_Store

# A converted tree left behind by tools/acc_to_omp.py or tools/dc_to_omp.py
# run with --write outside CI.
*.acc_backup
